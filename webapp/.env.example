# 智充图驭 Web 驾驶舱 环境变量示例
# 复制为 .env 并按需填写；未配置云实例时自动降级本地 SQLite/内存 LRU

# ── 服务 ──────────────────────────────────────────
WEBAPP_PORT=8000
# 仓库根目录（默认自动推断为 webapp 上级目录）
# EVGNN_REPO_ROOT=/workspace/ev-gnn
# 强制设备标识（调试用）：npu:0 / cuda:0 / cpu
# WEBAPP_DEVICE_FORCE=cpu

# ── 华为云 RDS MySQL ──────────────────────────────
# 未配置 MYSQL_HOST 时降级为本地 SQLite (webapp/local.db)
# MYSQL_HOST=xxx.mysql.rds.huaweicloud.com
# MYSQL_PORT=3306
# MYSQL_USER=evgnn
# MYSQL_PASSWORD=
# MYSQL_DB=evgnn

# ── 华为云 DCS Redis ──────────────────────────────
# 未配置 REDIS_URL 时降级为进程内 LRU
# REDIS_URL=redis://xxx.dcs.huaweicloud.com:6379/0

# ── 华为云 MaaS（AI 调度诊断，待接入）─────────────
# MAAS_ENDPOINT=https://maas.huaweicloud.com/v1/inferring
# MAAS_MODEL=
# MAAS_API_KEY=

# ── 缓存 TTL（秒）──────────────────────────────────
WEBAPP_CACHE_TTL_SUMMARY=30
WEBAPP_CACHE_TTL_TIMESERIES=60
